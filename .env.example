# Por padrão o serviço deve ficar restrito a 127.0.0.1.
# Configure um segredo longo e use HTTPS + proxy autenticado antes de acesso remoto.
STUDIO_API_TOKEN=
STUDIO_DATA_DIR=./storage
# Caminho de uma instalação autorizada do MuseTalk 1.5, com modelos baixados.
MUSETALK_DIR=
# Executável do ambiente Python com Torch/CUDA + dependências MuseTalk.
MUSETALK_PYTHON=python3
